# Keep the Vercel upload small. The serverless function needs only:
#   api/index.py, src/web_demo/{__init__,webapp,db}.py, src/web_demo/frontend/**
# and the root requirements.txt (now the slim web-only set).

node_modules/
data/
dataset/
outputs/
dist/
tests/
docs/
scripts/
**/__pycache__/

# recognition stack — never imported by the serverless function
requirements-recognition.txt
src/web_demo/backend.py
src/web_demo/requirements.txt
src/features/
src/models/
src/inference/
src/training/
src/data/
src/data_pipeline/

# large model binaries (recognition only)
*.pt
*.pth
*.task
