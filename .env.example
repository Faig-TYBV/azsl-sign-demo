# Copy to ".env" and fill in your machine's values.

# SQLAlchemy URL for the auth database (psycopg v3 driver).
#   postgresql+psycopg://<role>:<password>@<host>:<port>/<database>
# The database is auto-created on first startup if the role may CREATE DATABASE.
# Tables (users, friendships, messages) are created automatically either way.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/azsl_demo

# Secret used to sign the session cookie and the short-lived /ws tokens.
# Generate one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
# In a split deploy (pages on one host, recognition on another) BOTH hosts must
# use the same value, or cross-origin socket auth fails.
SESSION_SECRET=change-me

# 1 when serving over HTTPS (marks the session cookie Secure).
SESSION_COOKIE_SECURE=0


# --------------------------------------------------------------------------- #
# Optional: separate recognition backend
# --------------------------------------------------------------------------- #
# Only set this when the pages and the /ws recognition socket live on different
# hosts (e.g. pages on Vercel, recognition on Fly/Render). Leave it unset when
# one process serves everything.
# RECOGNITION_WS_URL=wss://azsl-recognition.fly.dev


# --------------------------------------------------------------------------- #
# Optional: WebRTC relay for friend calls
# --------------------------------------------------------------------------- #
# Audio/video calls go browser-to-browser. STUN (free, built in, no account) is
# enough for most home networks. Users behind symmetric NAT — typically mobile
# data and corporate firewalls — can only connect through a TURN relay, which
# carries the media and so always costs bandwidth and needs credentials.
#
# Leave these unset and calls still work for most pairs of users; the rest see
# a clear "network restricted" message instead of a hanging spinner.
#
# Get credentials from a managed provider (Metered, Twilio Network Traversal,
# Cloudflare Calls) or self-host coturn.
#
# TURN_URL takes a COMMA-SEPARATED list sharing one username/credential.
# Providers issue several on purpose: the UDP entry is fastest, but networks
# that block UDP are exactly the ones needing a relay, so always include the
# TLS/443 entry too. Pasted from a Metered dashboard it looks like:
#
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
#
# Check them with:  py scripts/verify_turn.py

# Comma-separated override of the default Google STUN servers.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
