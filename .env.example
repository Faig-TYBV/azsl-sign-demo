# Copy to ".env" and fill in your machine's values.

# SQLAlchemy URL for the auth database (psycopg v3 driver).
#   postgresql+psycopg://<role>:<password>@<host>:<port>/<database>
# The database is auto-created on first startup if the role may CREATE DATABASE.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/azsl_demo

# Secret used to sign the session cookie. Generate one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# 1 when serving over HTTPS (marks the session cookie Secure).
SESSION_COOKIE_SECURE=0
