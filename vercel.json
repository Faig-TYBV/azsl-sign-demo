{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "src/web_demo/frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/src/web_demo/frontend/$1" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
